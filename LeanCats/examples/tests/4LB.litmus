X86 4LB
{ x=0; y=0; z=0; w=0; }
P0                   | P1                   | P2                   | P3                   ;
MOV EAX,[x]          | MOV EBX,[y]          | MOV ECX,[z]          | MOV EDX,[w]          ;
MOV [w],$1           | MOV [x],$1           | MOV [y],$1           | MOV [z],$1           ;
exists (0:EAX=1 /\ 1:EBX=1 /\ 2:ECX=1 /\ 3:EDX=1)
