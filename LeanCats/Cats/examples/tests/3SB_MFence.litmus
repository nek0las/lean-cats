X86 3SB+MFence
{ x=0; y=0; z=0; }
P0                   | P1                   | P2                   ;
MOV [x],$1           | MOV [y],$1           | MOV [z],$1           ;
MFENCE               | MFENCE               | MFENCE               ;
MOV EAX,[y]          | MOV EBX,[z]          | MOV ECX,[x]          ;
exists (0:EAX=0 /\ 1:EBX=0 /\ 2:ECX=0)
